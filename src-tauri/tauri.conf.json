{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LightMD",
  "version": "0.1.0",
  "identifier": "com.lightmd.editor",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "LightMD", "width": 1100, "height": 820, "minWidth": 640, "minHeight": 480 }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: https:; connect-src ipc: http://ipc.localhost" } },
  "bundle": { "active": false }
}
